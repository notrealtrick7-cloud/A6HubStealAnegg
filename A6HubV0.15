--  UTIL
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local function notify(t)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification",{
            Title="A6 Hub Â· SAEv3", Text=tostring(t), Duration=3
        })
    end)
end
local function hrp()
    local c = LP.Character; return c and c:FindFirstChild("HumanoidRootPart")
end
local function humanoid()
    local c = LP.Character; return c and c:FindFirstChildOfClass("Humanoid")
end
local function webhook(title, desc, color)
    if not S.WebhookURL or S.WebhookURL=="" then return end
    pcall(function()
        local body = HttpSvc:JSONEncode({embeds={{
            title=title, description=desc, color=color or 65280,
            footer={text="A6 Hub Â· SAEv3"},
            timestamp=os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }}})
        local req = request or (syn and syn.request) or http_request
        if req then
            req({Url=S.WebhookURL,Method="POST",
                 Headers={["Content-Type"]="application/json"},Body=body})
        end
    end)
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
--  MOVEMENT
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local function stopMove()
    local hum = humanoid(); if not hum then return end
    pcall(function() hum:MoveTo(hrp() and hrp().Position or Vector3.zero) end)
end
local function walkTo(goal, timeout)
    local root=hrp(); local hum=humanoid()
    if not root or not hum then return false end
    timeout = timeout or 14
    local gp = typeof(goal)=="CFrame" and goal.Position or goal
    gp = Vector3.new(gp.X, root.Position.Y, gp.Z)
    acWalkSpeed(hum, S.StealWalkSpeed or 22)
    pcall(function() hum:MoveTo(gp) end)
    local t0 = tick()
    while tick()-t0 < timeout do
        root=hrp(); if not root then return false end
        local d = (Vector3.new(root.Position.X,0,root.Position.Z)
                 - Vector3.new(gp.X,0,gp.Z)).Magnitude
        if d < 5 then stopMove(); return true end
        if tick()-t0>2.5 and d>14 then
            pcall(function()
                hum:MoveTo(gp+Vector3.new(math.random(-2,2),0,math.random(-2,2)))
            end)
        end
        task.wait(jitter(0.15,0.05,0.1))
    end
    stopMove(); return false
end
local function softTweenTo(cf, speed)
    local root=hrp(); if not root then return end
    speed = math.clamp(speed or S.TweenSpeed or 40, 28, 80)
    local tp = typeof(cf)=="CFrame" and cf.Position or cf
    tp = Vector3.new(tp.X, root.Position.Y+jitter(1.2,-0.3,0.5), tp.Z)
    local dist = (root.Position-tp).Magnitude; if dist<3 then return end
    local t = math.clamp(dist/speed, 0.2, 7)
    local tw = TweenSvc:Create(root,TweenInfo.new(t,Enum.EasingStyle.Sine),{CFrame=CFrame.new(tp)})
    tw:Play()
    local done,t0=false,tick()
    tw.Completed:Connect(function() done=true end)
    while not done and tick()-t0<t+0.6 do task.wait(0.05) end
end
local function tweenTo(cf, speed)
    if S.MoveStyle=="Walk" then
        walkTo(typeof(cf)=="CFrame" and cf.Position or cf, 16)
    else softTweenTo(cf, speed) end
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
--  PET DETECT CACHE
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local PetCache = setmetatable({},{__mode="k"})
local PET_TTL  = 9.0
local function detectRarity(inst)
    if not inst then return "Common" end
    local now=tick(); local c=PetCache[inst]
    if c and now-c.t<PET_TTL and c.r then return c.r end
    local txt=(inst.Name or "")
    local a=inst:GetAttribute("Rarity") or inst:GetAttribute("rarity")
    if a then txt=txt.." "..tostring(a) end
    for _,d in ipairs(inst:GetChildren()) do
        if d:IsA("StringValue") or d:IsA("TextLabel") then
            txt=txt.." "..tostring(d.Text or d.Value or "")
        end
    end
    txt=txt:lower()
    local order={"divine","eternal","secret","cosmic","mythic","legendary","epic","rare","uncommon","common"}
    local map={divine="Divine",eternal="Eternal",secret="Secret",cosmic="Cosmic",mythic="Mythic",
               legendary="Legendary",epic="Epic",rare="Rare",uncommon="Uncommon",common="Common"}
    local res="Common"
    for _,k in ipairs(order) do if txt:find(k,1,true) then res=map[k]; break end end
    c=c or {}; c.t=now; c.r=res; PetCache[inst]=c; return res
end
local function detectPetName(inst)
    if not inst then return nil end
    local now=tick(); local c=PetCache[inst]
    if c and now-c.t<PET_TTL and c.pet~=nil then return c.pet or nil end
    local txt=tostring(inst.Name or "")
    local a,b=inst:GetAttribute("PetName"),inst:GetAttribute("Name")
    if a then txt=txt.." "..tostring(a) end
    if b then txt=txt.." "..tostring(b) end
    for _,d in ipairs(inst:GetChildren()) do
        if d:IsA("StringValue") or d:IsA("TextLabel") then
            txt=txt.." "..tostring(d.Text or d.Value or "")
        end
    end
    txt=txt:lower()
    local best,bestLen=nil,0
    for _,pet in ipairs(S.PetCatalog) do
        local key=pet.n:lower()
        if #key>bestLen and txt:find(key,1,true) then best,bestLen=pet.n,#key end
    end
    c=c or{}; c.t=now; c.pet=best or false; PetCache[inst]=c; return best
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
--  WHITELIST / BLACKLIST FILTER
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local function isAllowed(rarity, petName)
    rarity=rarity or "Common"
    if S.BlacklistRarity[rarity] then return false end
    if petName and S.PetBlacklist[petName:lower()] then return false end
    local mode=S.FilterMode or "Rarity"
    if mode=="Pet" or mode=="Both" then
        local anyPet=false
        for _,v in pairs(S.PetWhitelist) do if v then anyPet=true; break end end
        if anyPet then
            if petName and S.PetWhitelist[petName:lower()] then return true end
            if mode=="Pet" then return false end
        end
    end
    if mode=="Rarity" or mode=="Both" then
        if S.WhitelistRarity[rarity] then return true end
        local t=S.RarityTier[rarity] or 1
        if t>=(S.MinTier or 1) and t<=(S.MaxTier or 10) then
            local anyR=false
            for _,v in pairs(S.WhitelistRarity) do if v then anyR=true; break end end
            if not anyR then return true end
        end
        return false
    end
    return true
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
--  EGG SCAN CACHE â€” cache 6s, shuffle AC bypass
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local EggCache={t=0,list={}}
local EGG_TTL=6.0
local function collectEggs(force)
    local now=tick()
    if not force and now-EggCache.t<EGG_TTL then return EggCache.list end
    local list={}
    for _,v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local n=(v.Name.." "..(v.Parent and v.Parent.Name or "")):lower()
            if n:find("egg",1,true) or n:find("steal",1,true)
               or n:find("grab",1,true) or n:find("pick",1,true) or n:find("take",1,true) then
                local obj=v.Parent or v
                table.insert(list,{prompt=v,rarity=detectRarity(obj),parent=v.Parent,pet=detectPetName(obj)})
            end
        end
    end
    -- AC bypass: shuffle Ä‘á»ƒ khĂ´ng cĂ¹ng thá»© tá»± má»—i láº§n
    for i=#list,2,-1 do
        local j=math.random(i); list[i],list[j]=list[j],list[i]
    end
    EggCache.t=now; EggCache.list=list; return list
end
local function nearestAllowedEgg()
    local root=hrp(); if not root then return nil end
    local best,dist=nil,math.huge
    for _,e in ipairs(collectEggs()) do
        if isAllowed(e.rarity,e.pet) then
            local part=e.parent; local pos
            if part and part:IsA("BasePart") then pos=part.Position
            elseif part and part:IsA("Model") then
                local pp=part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
                if pp then pos=pp.Position end
            end
            if pos then
                local d=(pos-root.Position).Magnitude
                if d<dist then best,dist=e,d end
            end
        end
    end
    return best,dist
end
local function findBiomePart(name)
    for _,v in ipairs(workspace:GetDescendants()) do
        if v.Name:lower():find(name:lower()) and (v:IsA("BasePart") or v:IsA("Model")) then
            if v:IsA("BasePart") then return v end
            local p=v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
            if p then return p end
        end
    end
end
local function findEnchantedForest()
    return findBiomePart("Enchanted") or findBiomePart("EnchantForest") or findBiomePart("Enchanted Forest")
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
--  ACTIONS
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local function dropEgg()
    pcall(function() local h=humanoid(); if h then h:UnequipTools() end end)
    local root=hrp(); if not root then return false end
    for _,p in ipairs(workspace:GetDescendants()) do
        if p:    task.wait(jitter(1.5,0.5,2.0))
    while task.wait(jitter(0.22,0.05,0.18)) do
        local now=os.clock()
        local bestLabel,bestScore=nil,-math.huge
        for _,label in ipairs(S.FeaturePriority) do
            local key=S.FeaturePriorityKey[label]
            if key and _priorityEnabled(label) then
                local next=_prioNext[key] or 0
                if now>=next then
                    local rank=_priorityIndex(label)
                    local score=(now-next)*10-rank
                    if score>bestScore then bestScore,bestLabel=score,label end
                end
            end
        end
        if bestLabel then
            local key=S.FeaturePriorityKey[bestLabel]
            local base=BASE_INTERVAL[key] or 1.5
            _prioNext[key]=now+base*(0.7+math.random()*1.7)
            if key=="AutoSteal" then
                if not _Stealing then pcall(doStealOnce) end
            elseif key=="AutoScramble" then pcall(doScrambleEvent)
            elseif key=="AutoPlace"    then pcall(tryPlace)
            elseif key=="AutoHatch"    then pcall(tryHatch)
            elseif key=="AutoIndex"    then if not _Stealing then pcall(doStealOnce) end
            elseif key=="AutoTreadmill" then
                if S.AutoTreadmill and not _Stealing then pcall(farmTreadmill) else stopMove() end
            end
        end
        local function aux(label,enabled,base,fn)
            if not enabled then return end
            local t=_prioNext[label] or 0
            if now>=t then _prioNext[label]=now+base*(0.8+math.random()*1.4); pcall(fn) end
        end
        aux("sell",   S.AutoSell,             4.5,trySell)
        aux("mutation",S.AutoMutation,         3.2,tryMutation)
        aux("upTM",   S.AutoUpgradeTreadmill, 9.0,upgradeTreadmill)
        aux("upPlot", S.AutoUpgradePlot,       9.0,upgradePlot)
    end
end)

task.spawn(function()
    task.wait(jitter(0.5,0.2,0.5))
    while task.wait(jitter(0.22,0.08,0.15)) do
        local hum=humanoid()
        if hum then
            if S.SpeedBoost then acWalkSpeed(hum,S.WalkSpeed) end
            if S.JumpBoost then pcall(function()
                hum.JumpPower=S.JumpPower+math.random(-1,1); hum.UseJumpPower=true end) end
        end
        if S.AntiRagdoll then pcall(function()
            local c=LP.Character; if not c then return end
            local h=c:FindFirstChildOfClass("Humanoid")
            if h and h:GetState()==Enum.HumanoidStateType.Physics then
                h:ChangeState(Enum.HumanoidStateType.Running) end end) end
    end
end)

task.spawn(function()
    while task.wait(jitter(32,8,15)) do
        if S.AntiAFK then pcall(function()
            VUser:CaptureController(); VUser:ClickButton2(Vector2.new()) end) end
    end
end)

UIS.JumpRequest:Connect(function()
    if S.InfJump then
        local hum=humanoid()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

