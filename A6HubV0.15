        local grouped={}; local biomeOrder={}
        for _,pet in ipairs(S.PetCatalog) do
            if f=="" or pet.n:lower():find(f,1,true) or pet.b:lower():find(f,1,true) then
                if not grouped[pet.b] then grouped[pet.b]={}; table.insert(biomeOrder,pet.b) end
                table.insert(grouped[pet.b],pet)
            end
        end
        local seen={}; local deduped={}
        for _,b in ipairs(biomeOrder) do if not seen[b] then seen[b]=true; table.insert(deduped,b) end end
        for _,biome in ipairs(deduped) do
            local brow=Instance.new("TextLabel",petListHost)
            brow.Size=UDim2.new(1,0,0,18); brow.BackgroundTransparency=1
            brow.Font=Enum.Font.GothamBold; brow.TextSize=10
            brow.TextColor3=Color3.fromRGB(100,200,255); brow.TextXAlignment=Enum.TextXAlignment.Left
            brow.Text="  â—† "..biome
