--  AC BYPASS CORE
--  Má»i timing Ä‘i qua Ä‘Ă¢y â€” khĂ´ng cĂ³ constant interval nĂ o
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
local function jitter(base, lo, hi)
    lo = lo or -0.15; hi = hi or 0.15
    return base + lo + math.random() * (hi - lo)
end
local function acWait(base)
    task.wait(jitter(base, base * 0.3, base * 1.1))
end
local function acFirePrompt(prompt)
    if not prompt then return end
    task.wait(jitter(0.12, 0.04, 0.28))
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(jitter(0.06, 0.03, 0.12))
            prompt:InputHoldEnd()
        end
    end)
    task.wait(jitter(0.08, 0.02, 0.18))
end
local function acWalkSpeed(hum, target)
    if not hum then return end
    local noise = math.random(-3, 3)
    pcall(function() hum.WalkSpeed = math.clamp(target + noise, 14, 85) end)
end

