-- [7] PET FILTER
-- ══════════════════════════════════════════
local function Match(name, list)
    for _,v in ipairs(list) do
        if name:lower():find(v:lower()) then return true end
    end
    return false
end
local function PetOK(name)
    if Match(name, Cfg.BlacklistedPets) then return false end
    if #Cfg.WhitelistedPets == 0 then return true end
    return Match(name, Cfg.WhitelistedPets)
end

-- ══════════════════════════════════════════
-- [8] EGG FINDER
-- ══════════════════════════════════════════
local EggKW = {"egg","nest","hatch","spawn"}
local function IsEgg(obj)
    local n = obj.Name:lower()
    for _,kw in ipairs(EggKW) do if n:find(kw) then return true end end
    return false
end
local function ObjPos(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("Model") then
        local ok,p = pcall(function() return obj:GetPivot().Position end)
        return ok and p or nil
    elseif obj:IsA("BasePart") then return obj.Position end
end

local function GetTargetEgg(filtered)
    if not RC() then return nil end
    local best, bestD = nil, Cfg.StealRadius
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not(obj:IsA("Model") or obj:IsA("BasePart")) then continue end
        if not IsEgg(obj) then continue end
        local ot = obj:FindFirstChild("Owner") or obj:FindFirstChild("PlayerName")
        if ot and (ot.Value==lp.Name or ot.Value==lp.UserId) then continue end
        if filtered and #Cfg.WhitelistedPets > 0 then
            local pn = obj.Name
            local pt = obj:FindFirstChild("PetType") or obj:FindFirstChild("PetName")
            if pt then pn = pt.Value end
            if not PetOK(pn) then continue end
        end
        local pos = ObjPos(obj)
        if not pos then continue end
        local d = (hrp.Position - pos).Magnitude
        if d < bestD then best=obj; bestD=d end
    end
    return best
end

