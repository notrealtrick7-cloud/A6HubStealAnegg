local _rc = {}
local function FindRemote(name)
    if _rc[name] and _rc[name].Parent then return _rc[name] end
    local r = workspace:FindFirstChild(name,true) or RS:FindFirstChild(name,true)
    if r then _rc[name]=r end
    return r
end

local StealRemotes = {
    "StealEgg","Steal","PickupEgg","CollectEgg",
    "TakeEgg","GrabEgg","EggSteal","Collect","Pickup","Interact"
}

-- ══════════════════════════════════════════
-- [10] FIRE E  (Delta: no keypress/VIM)
-- ══════════════════════════════════════════
local function FireE(eggObj)
    -- Priority 1: ProximityPrompt
    if eggObj and eggObj.Parent then
        local pp = eggObj:FindFirstChildWhichIsA("ProximityPrompt",true)
        if pp then
            local ht = (pp.HoldDuration or 0) + 0.25
            pcall(function() _fpp(pp) end)
            task.wait(ht)
            return true
        end
    end

    -- Priority 2: Remote
    if eggObj then
        for _, rName in ipairs(StealRemotes) do
            local r = FindRemote(rName)
            if r then
                if r:IsA("RemoteEvent") then
                    pcall(function() r:FireServer(eggObj) end)
                elseif r:IsA("RemoteFunction") then
                    pcall(function() r:InvokeServer(eggObj) end)
                end
                task.wait(0.3)
                return true
            end
        end
    end

    -- Priority 3: TouchInterest
    if eggObj and char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            local parts = eggObj:IsA("Model") and eggObj:GetDescendants() or {eggObj}
            for _, p in ipairs(parts) do
                if p:IsA("BasePart") then
                    pcall(function() _fti(root,p,0) end)
                end
            end
        end
    end

    task.wait(Cfg.HoldDuration)
    return false
end

-- ══════════════════════════════════════════
-- [11] TELEPORT DETECT
-- ══════════════════════════════════════════
local function WaitTele(timeout)
    if not hrp then return false end
    local start = hrp.Position
    local elapsed = 0
    while elapsed < timeout do
        task.wait(0.05); elapsed += 0.05
        if not hrp or not hrp.Parent then return false end
        if (hrp.Position - start).Magnitude > Cfg.TeleportThreshold then
            return true
        end
    end
    return false
end

-- ══════════════════════════════════════════
-- [12] STEAL CYCLE
-- ══════════════════════════════════════════
local function StealCycle()
    if Cfg._cycleRunning then return end
    Cfg._cycleRunning = true

    local egg = GetTargetEgg(true)
    if not egg then Cfg._cycleRunning=false; return end

    local pos = ObjPos(egg)
    if not pos then Cfg._cycleRunning=false; return end

    -- Walk to egg
    MoveTo(pos, 5)
    if not egg.Parent then Cfg._cycleRunning=false; return end

    -- Hold E
    task.spawn(function() FireE(egg) end)

    -- Wait for game teleport
    local teleported = WaitTele(Cfg.TeleportWaitMax)

    if teleported then
        task.wait(Cfg.LakeHoldDelay)
        local lakeEgg = GetTargetEgg(false)
        FireE(lakeEgg)
        task.wait(0.4)
        Hook("🥚 Cycle Done","Stole → Lake → grabbed",0xF1C40F)
    else
        Hook("🥚 Grabbed","Direct collect",0xF1C40F)
    end

    if Cfg.BaseSet then MoveTo(Cfg.BasePos, 6) end
    Cfg._cycleRunning = false
end

