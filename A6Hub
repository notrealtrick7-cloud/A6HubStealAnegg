-- ══════════════════════════════════════════
local BossKW = {"cramble","dr.cramble","drcramble","boss"}
local AtkR   = {"AttackBoss","DamageBoss","HitBoss","Attack","Damage","Strike"}

local function FindBoss()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local n = obj.Name:lower()
            for _,kw in ipairs(BossKW) do if n:find(kw) then return obj end end
        end
    end
end

local function FarmBoss()
    if Cfg._bossSearching then return end
    Cfg._bossSearching = true
    Hook("👾 Boss","Dr. Cramble spotted",0xE74C3C)
    local boss = FindBoss()
    if not boss then
        Hook("⚠️ Boss","Not found",0xF39C12)
        Cfg._bossSearching=false; return
    end
    local bp = ObjPos(boss)
    if bp then MoveTo(bp) end
    local atk
    for _,rn in ipairs(AtkR) do
        local r = FindRemote(rn); if r then atk=r; break end
    end
    local dl = tick()+240
    while Cfg.AutoBoss and Cfg._running and boss and boss.Parent and tick()<dl do
        local hpObj = boss:FindFirstChildWhichIsA("Humanoid",true)
        if hpObj and hpObj.Health<=0 then break end
        local p = ObjPos(boss)
        if p and hrp and (hrp.Position-p).Magnitude>12 then MoveTo(p) end
        if atk then
            if atk:IsA("RemoteEvent") then pcall(function() atk:FireServer(boss) end)
            else pcall(function() atk:InvokeServer(boss) end) end
        end
        local pp = boss:FindFirstChildWhichIsA("ProximityPrompt",true)
        if pp then pcall(function() _fpp(pp) end) end
        task.wait(0.2)
    end
    Hook("✅ Boss","Dr. Cramble cleared",0x2ECC71)
    Cfg._bossSearching = false
end

task.spawn(function()
    while Cfg._running do
        task.wait(60)
        if Cfg.AutoBoss and not Cfg._bossSearching then
            if FindBoss() then task.spawn(FarmBoss) end
        end
    end
end)

