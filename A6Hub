-- [6] PATHFINDING
-- ══════════════════════════════════════════
local function MoveTo(target, close)
    if not RC() then return end
    close = close or 4
    if (hrp.Position - target).Magnitude < close then return end
    local path = PathfindingService:CreatePath({
        AgentHeight=5, AgentRadius=2,
        AgentCanJump=true, AgentCanClimb=true, WaypointSpacing=4
    })
    local ok = pcall(function() path:ComputeAsync(hrp.Position, target) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        hum:MoveTo(target); hum.MoveToFinished:Wait(5); return
    end
    for _, wp in ipairs(path:GetWaypoints()) do
        if not Cfg._running then return end
        if not RC() then return end
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true; task.wait(0.15)
        end
        hum:MoveTo(wp.Position)
        if not hum.MoveToFinished:Wait(3) then
            hum.Jump = true; task.wait(0.3)
        end
    end
end

